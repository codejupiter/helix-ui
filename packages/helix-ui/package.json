{
  "name": "@codejupiter/helix-ui",
  "version": "0.1.0",
  "description": "Custom-built, accessible React component primitives.",
  "author": "Zoriah Cocio <info@zoriahcocio.com>",
  "license": "MIT",
  "homepage": "https://github.com/codejupiter/helix-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codejupiter/helix-ui.git"
  },
  "bugs": {
    "url": "https://github.com/codejupiter/helix-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "size": "node scripts/check-bundle-size.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitest/coverage-v8": "^1.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "accessibility",
    "design-system",
    "typescript",
    "wcag",
    "compound-components",
    "component-library"
  ],
  "publishConfig": {
    "access": "public"
  }
}
